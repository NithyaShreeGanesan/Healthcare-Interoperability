# Flask Configuration
FLASK_APP=app:create_app
FLASK_ENV=development
FLASK_DEBUG=1
SECRET_KEY=change-this-in-production-random-secret-key
PORT=5000

# Database Configuration
# For MySQL 8: mysql+pymysql://<user>:<password>@<host>:3306/<dbname>
# For local SQLite fallback: sqlite:///healthcare_interop.db
DATABASE_URL=sqlite:///healthcare_interop.db

# JWT Security
JWT_SECRET_KEY=change-this-in-production-jwt-secret-key
JWT_ACCESS_TOKEN_EXPIRES=86400

# Field-Level Encryption (cryptography.Fernet 32 url-safe base64-encoded bytes)
FERNET_KEY=

# HTTPS / TLS Configuration (Self-signed cert for dev)
USE_HTTPS=false
SSL_CERT_PATH=scripts/certs/cert.pem
SSL_KEY_PATH=scripts/certs/key.pem
